# Chargeback Shield Production Runtime Environment Template (.env.production.example)
# IMPORTANT: Secrets are injected at runtime via environment variables or cloud secrets manager.

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Persistent Database Configuration
DATABASE_URL=sqlite+aiosqlite:////app/data/chargeback_shield.db

# Production CORS & Frontend Origins
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
FRONTEND_URL=http://localhost

# API Controls
ENABLE_DOCS=false
ENABLE_OPENAPI=false

# Razorpay Credentials (Runtime Secrets — NEVER commit values!)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Public Frontend API URL (Non-secret)
VITE_API_BASE_URL=http://localhost/api
