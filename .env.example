# Chargeback Shield — Production Configuration Template (.env.example)
# IMPORTANT: This file contains safe placeholders only. NEVER commit real credentials.

# Application Environment Settings
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./chargeback_shield.db

# CORS & Frontend Origins (Comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# API & Server Settings
API_PREFIX=/api
REQUEST_TIMEOUT=30
MAX_REQUEST_SIZE=10485760

# API Documentation Controls (Disabled in production)
ENABLE_DOCS=false
ENABLE_OPENAPI=false

# Razorpay Credentials (Loaded strictly from environment/secrets manager)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Groq Vision LLM API Credentials
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b

# Upload Directories & Storage Safeguards
UPLOAD_DIR=./storage/evidence
PROCESSED_DIR=./storage/processed
MAX_PDF_SIZE_BYTES=2097152
MAX_IMAGE_SIZE_BYTES=4194304
